{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "allowJs": true,
    "types": ["vite/client", "@sveltejs/kit"]
  },
  "include": [
    "src/**/*" ],
  "exclude": ["node_modules", "dist"]
}
